# CareerOS Frontend Environment Configuration Template
# Copy this file to .env (or .env.production) to configure the Vite SPA client.
# NOTE: Variables prefixed with VITE_ are statically compiled into client JavaScript bundles at build time.

# Backend API Base URL
# URL of the CareerOS Express backend API (no trailing slash).
# In local development: http://localhost:5000
# In production behind a unified reverse proxy: /api or https://api.careeros.app
VITE_API_URL=http://localhost:5000
